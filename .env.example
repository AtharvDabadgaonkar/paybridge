# PayBridge environment configuration (copy to .env; never commit real keys)

# OPTIONAL. Enables the FraudLens AI Copilot's LLM explanation layer.
# Without it the app runs fully in deterministic fallback mode.
ANTHROPIC_API_KEY=

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=1200

# Optional path overrides (defaults: ./data, ./models)
# PAYBRIDGE_DATA_DIR=./data
# PAYBRIDGE_MODEL_DIR=./models
# PAYBRIDGE_DB_PATH=./data/paybridge.db
